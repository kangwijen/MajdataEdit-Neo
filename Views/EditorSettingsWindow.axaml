<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MajdataEdit_Neo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="220"
        x:Class="MajdataEdit_Neo.Views.EditorSettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Text Editor Settings"
        Width="400"
        SizeToContent="Height"
        MinWidth="360"
        MinHeight="200"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Text Editor" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

    <StackPanel Grid.Row="1" Spacing="18">
      <StackPanel Spacing="6">
        <Label Target="EditorFontSizeControl">Font size</Label>
        <NumericUpDown Name="EditorFontSizeControl" Value="{Binding EditorFontSize}" Minimum="6" Maximum="72" Increment="1"
                       HorizontalAlignment="Stretch"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,28,0,0">
      <Button Content="Reset to Default" MinWidth="140" Click="ResetToDefaultButton_Click"/>
      <Button Content="Close" MinWidth="80" Click="CloseButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
